# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────
# Either a full URL...
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/jssf
# ...or discrete parts (URL takes precedence if set)
PGHOST=localhost
PGPORT=5432
PGUSER=YOUR_DB_USER
PGPASSWORD=YOUR_DB_PASSWORD
PGDATABASE=jssf
PG_POOL_MAX=10
# TLS to Postgres: disable (local dev) | require (managed PG, no CA check) | verify-full
PGSSLMODE=disable

# ── Auth / JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# "Remember me" extends refresh token lifetime
JWT_REFRESH_TTL_REMEMBER=30d

# ── Security ────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
# Set to true ONLY when running behind a reverse proxy (nginx etc.)
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Seed admin (used by npm run seed) ───────────────────
SEED_ADMIN_EMAIL=admin@jssf.local
SEED_ADMIN_MOBILE=9999999999
SEED_ADMIN_PASSWORD=Admin@123
