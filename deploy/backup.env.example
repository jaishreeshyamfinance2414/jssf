# Copy this file to /home/ubuntu/.config/jssf/backup.env on the server.
# Never commit real credentials. The backup script loads this file automatically.
B2_BUCKET='jssf-backups'
B2_KEY_ID='replace_with_backblaze_key_id'
B2_APPLICATION_KEY='replace_with_backblaze_application_key'
B2_ENDPOINT='https://s3.YOUR-B2-REGION.backblazeb2.com'

# Optional. Normally derived from B2_ENDPOINT, for example us-west-004.
# B2_REGION=us-west-004
