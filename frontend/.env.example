# API access — leave both unset for the default setup.
#
# By default the browser calls the API same-origin at /api/v1 and Next.js
# proxies it to the backend (see next.config.mjs). This works on localhost,
# LAN IPs, and HTTPS without CORS or cookie issues.

# Where the Next.js proxy forwards API calls (server-side, defaults to
# http://localhost:4000). Set only if the backend runs elsewhere.
# API_PROXY_TARGET=http://localhost:4000

# Set only if the browser should call the backend directly, bypassing the proxy.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
